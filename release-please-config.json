{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "data",
      "section": "Tariff data",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "openbijli",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/data/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/engine/package.json",
          "jsonpath": "$.dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "packages/evidence/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/evidence/package.json",
          "jsonpath": "$.dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "packages/evidence/package.json",
          "jsonpath": "$.dependencies['@openbijli/engine']"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.dependencies['@openbijli/engine']"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.dependencies['@openbijli/evidence']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/data'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/engine'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/engine'].dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/evidence'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/evidence'].dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/evidence'].dependencies['@openbijli/engine']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].dependencies['@openbijli/data']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].dependencies['@openbijli/engine']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].dependencies['@openbijli/evidence']"
        }
      ]
    }
  }
}
