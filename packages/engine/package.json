{
  "name": "@openbijli/engine",
  "version": "0.1.0",
  "description": "Indian electricity bill engine (slabs, fixed charges, ToD, subsidies, net metering/net billing/gross metering) and a rooftop solar right-sizing and payback simulator.",
  "author": "OpenBijli contributors",
  "homepage": "https://github.com/byjoellobo/openbijli/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byjoellobo/openbijli.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/byjoellobo/openbijli/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "india",
    "electricity",
    "bill",
    "tariff",
    "rooftop-solar",
    "net-metering",
    "payback",
    "pm-surya-ghar"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "openbijli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@openbijli/data": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
