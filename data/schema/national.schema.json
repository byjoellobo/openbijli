              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "verification": {
          "type": "string",
          "enum": [
            "verified",
            "secondary",
            "unverified"
          ]
        }
      },
      "required": [
        "tiers",
        "note",
        "cite",
        "verification"
      ],
      "additionalProperties": false
