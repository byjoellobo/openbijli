              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "capInr": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "specialCategoryCapInr": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cite": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "page": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "secondary",
              "unverified"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tiers",
          "cite",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "installedCost": {
