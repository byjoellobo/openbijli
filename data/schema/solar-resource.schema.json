{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "regulator_order",
            "regulation",
            "gazette",
            "utility_page",
            "government_page",
            "news",
            "dataset",
            "other"
          ]
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "accessed": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archiveUrl": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "type",
        "accessed"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "string",
      "minLength": 10
    },
    "locations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "stateCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "lat": {
            "type": "number",
            "minimum": 5,
            "maximum": 38
          },
          "lon": {
            "type": "number",
            "minimum": 67,
            "maximum": 98
          },
          "poaKwhPerM2Day": {
            "minItems": 12,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "ghiKwhPerM2Day": {
            "minItems": 12,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "required": [
          "id",
          "name",
          "stateCode",
          "lat",
          "lon",
          "poaKwhPerM2Day",
          "ghiKwhPerM2Day"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "method",
    "locations"
  ],
  "additionalProperties": false,
  "title": "OpenBijli solar resource file"
}
